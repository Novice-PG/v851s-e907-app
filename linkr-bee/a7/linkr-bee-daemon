def log(message):
    sys.stdout.write("%s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), message))
    sys.stdout.flush()


# --------------------------------------------------------------------------
# rpmsg endpoint (rpmsg_char)
# --------------------------------------------------------------------------

class EndpointInfo(ctypes.Structure):
    _fields_ = [
        ("name", ctypes.c_char * 32),
        ("src", ctypes.c_uint32),
        ("dst", ctypes.c_uint32),
    ]


def _rpmsg_devices():
    found = set()
    try:
        for name in os.listdir("/dev"):
            if name.startswith("rpmsg") and name[5:].isdigit():
                found.add(name)
    except OSError:
        pass
    return found


class RpmsgBridge:
    """Owns one rpmsg endpoint and pumps RX data into `on_data`."""

    def __init__(self, on_data, max_chunk=256):
        self.on_data = on_data
        self.ctrl_fd = None
        self.fd = None
        self.path = None
        self.send_lock = threading.Lock()
        self.ready = False
        # rpmsg_char rejects writes larger than the endpoint MTU
        # (EMSGSIZE / errno 90). The Linux rpmsg buffer is 512 bytes, minus
        # the 16-byte rpmsg header, so 256 leaves plenty of headroom and
        # matches RX_CHUNK on the E907 side.
        self.max_chunk = max_chunk

    def _create_endpoint(self):
        before = _rpmsg_devices()

        ctrl = os.open("/dev/rpmsg_ctrl0", os.O_RDWR)
        info = EndpointInfo()
        info.name = b"rpmsg_chrdev"
        info.src = RPMSG_ADDR_ANY
        info.dst = 0
        try:
            fcntl.ioctl(ctrl, RPMSG_CREATE_EPT_IOCTL, bytes(info))
        except OSError:
            os.close(ctrl)
            raise

        deadline = time.time() + 5.0
        path = None
        while time.time() < deadline:
            new = _rpmsg_devices() - before
            if new:
                path = "/dev/" + sorted(new)[0]
                break
            time.sleep(0.05)
        if path is None:
            os.close(ctrl)
            raise RuntimeError("no /dev/rpmsgN appeared")

        fd = os.open(path, os.O_RDWR)

        # Tell the E907 firmware the A7 endpoint address. It replies once the
        # bridge is armed.
        os.write(fd, b"LINKR1\n")
        reply = b""
        try:
            import select
            if select.select([fd], [], [], 2.0)[0]:
                reply = os.read(fd, 4096)
        except OSError:
            pass

        self.ctrl_fd = ctrl
        self.fd = fd
        self.path = path
        self.ready = True
        log("rpmsg endpoint %s ready, handshake reply %r" % (path, reply))

    def _drop_endpoint(self):
        self.ready = False
        if self.fd is not None:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = None
        if self.ctrl_fd is not None:
            try:
                fcntl.ioctl(self.ctrl_fd, RPMSG_DESTROY_EPT_IOCTL)
            except OSError:
                pass
            try:
                os.close(self.ctrl_fd)
            except OSError:
                pass
            self.ctrl_fd = None

    def _run(self):
        while True:
            try:
                self._create_endpoint()
            except Exception as exc:  # noqa: BLE001 - keep retrying forever
                log("rpmsg setup failed: %s" % exc)
                time.sleep(2.0)
                continue

            try:
                while True:
                    data = os.read(self.fd, 4096)
                    if not data:
                        raise OSError("endpoint closed")
                    self.on_data(data)
            except OSError as exc:
                log("rpmsg RX stopped: %s" % exc)
            finally:
                self._drop_endpoint()

            time.sleep(1.0)

    def start(self):
        threading.Thread(target=self._run, name="rpmsg", daemon=True).start()

    def send(self, data):
        """Write `data` to the E907, splitting it into MTU-sized chunks.

        A single rpmsg message cannot carry more than the endpoint MTU;
        the browser sends whatever the user types or pastes, so chunking
        has to happen here rather than in the WebSocket layer.
        """
        with self.send_lock:
            if self.fd is None:
                raise OSError("rpmsg endpoint not ready")
            view = memoryview(data)
            sent = 0
            while sent < len(view):
                chunk = view[sent:sent + self.max_chunk]
                n = os.write(self.fd, chunk)
                if n <= 0:
                    break
                sent += n
            return sent


class SerialWriter:
    """Feed serial bytes to the E907 from a dedicated thread.

    UART TX is a real 115200 baud line, so a paste of tens of kilobytes
    takes seconds to leave the wire. If the WebSocket reader wrote to
    rpmsg synchronously, control frames (@c?, @i?) would sit unread behind
    the bulk data. Instead the reader enqueues and returns immediately,
    while this thread paces the writes. The queue is bounded: when the
    browser sends faster than the line can carry, excess bytes are
    dropped and counted, matching the firmware's behaviour.
    """

    def __init__(self, bridge, limit=262144, chunk=256):
        self.bridge = bridge
        self.limit = limit
        self.chunk = chunk
        self.buf = bytearray()
        self.lock = threading.Lock()
        self.cond = threading.Condition(self.lock)
        self.dropped = 0
        self.drop_logged = 0
        self.thread = threading.Thread(target=self._run, name="serial-tx",
                                       daemon=True)

    def start(self):
        self.thread.start()

    def write(self, data):
        """Queue `data`; return how many bytes were accepted."""
        with self.cond:
            room = self.limit - len(self.buf)
            if room <= 0:
                self.dropped += len(data)
                self.cond.notify()
                self._log_drops()
                return 0
            if len(data) > room:
                self.dropped += len(data) - room
                data = data[:room]
            self.buf += data
            self.cond.notify()
            self._log_drops()
            return len(data)

    def _log_drops(self):
        mark = self.dropped // 8192
        if mark != self.drop_logged:
            self.drop_logged = mark
            log("serial queue full: dropped %d bytes so far (limit %d)" %
                (self.dropped, self.limit))

    def _run(self):
        while True:
            with self.cond:
                while not self.buf:
                    self.cond.wait()
                chunk = bytes(self.buf[:self.chunk])
                del self.buf[:self.chunk]
            try:
                self.bridge.send(chunk)
            except OSError as exc:
                log("rpmsg TX failed: %s; dropped %d bytes" % (exc, len(chunk)))
                time.sleep(0.2)


# --------------------------------------------------------------------------
# WebSocket helpers
# --------------------------------------------------------------------------

def _recv_exact(sock, size):
    chunks = []
    left = size
    while left > 0:
        chunk = sock.recv(left)
        if not chunk:
            raise ConnectionError("peer closed")
        chunks.append(chunk)
        left -= len(chunk)
    return b"".join(chunks)


def ws_recv_message(sock):
    """Return (opcode, payload), reassembling fragmented data messages."""
    fragments = b""
    first_opcode = None
    while True:
        header = _recv_exact(sock, 2)
        fin = header[0] & 0x80
        opcode = header[0] & 0x0F
        masked = header[1] & 0x80
        length = header[1] & 0x7F

        if length == 126:
            length = struct.unpack("!H", _recv_exact(sock, 2))[0]
        elif length == 127:
            length = struct.unpack("!Q", _recv_exact(sock, 8))[0]
        if length > MAX_FRAME:
            raise ValueError("websocket frame too large")

        mask = _recv_exact(sock, 4) if masked else b""
        data = _recv_exact(sock, length) if length else b""
        if masked:
            data = bytes(byte ^ mask[i % 4] for i, byte in enumerate(data))

        if opcode == 0x0:
            fragments += data
            if fin:
                return first_opcode or 0x1, fragments
        elif opcode in (0x1, 0x2):
            if fin:
                return opcode, data
            first_opcode = opcode
            fragments = data
        elif opcode in (0x8, 0x9, 0xA):
            return opcode, data
        else:
            raise ValueError("unsupported websocket opcode %d" % opcode)


