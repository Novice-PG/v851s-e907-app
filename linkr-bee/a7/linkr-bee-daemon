# HTTP server
# --------------------------------------------------------------------------

MIME = {
    ".html": "text/html; charset=utf-8",
    ".js": "text/javascript; charset=utf-8",
    ".mjs": "text/javascript; charset=utf-8",
    ".css": "text/css; charset=utf-8",
    ".json": "application/json",
    ".svg": "image/svg+xml",
    ".png": "image/png",
    ".jpg": "image/jpeg",
    ".jpeg": "image/jpeg",
    ".gif": "image/gif",
    ".ico": "image/x-icon",
    ".woff": "font/woff",
    ".woff2": "font/woff2",
    ".ttf": "font/ttf",
    ".wasm": "application/wasm",
    ".txt": "text/plain; charset=utf-8",
    ".map": "application/json",
}


def _read_request(conn):
    conn.settimeout(10.0)
    data = b""
    while b"\r\n\r\n" not in data:
        chunk = conn.recv(4096)
        if not chunk:
            return None
        data += chunk
        if len(data) > 65536:
            return None
    head = data.split(b"\r\n\r\n", 1)[0].decode("latin-1")
    lines = head.split("\r\n")
    parts = lines[0].split()
    if len(parts) < 2:
        return None
    headers = {}
    for line in lines[1:]:
        if ":" in line:
            key, value = line.split(":", 1)
            headers[key.strip().lower()] = value.strip()
    return parts[0].upper(), parts[1], headers


def _http_response(conn, status, body, content_type, extra=""):
    header = ("HTTP/1.1 %s\r\n"
              "Content-Type: %s\r\n"
              "Content-Length: %d\r\n"
              "Connection: close\r\n"
              "Cache-Control: no-cache\r\n"
              "%s\r\n" % (status, content_type, len(body), extra))
    conn.sendall(header.encode("latin-1") + body)


def serve_file(conn, web_root, url_path):
    path = urllib.parse.unquote(url_path.split("?")[0].split("#")[0])
    if path in ("", "/"):
        path = "/index.html"
    if path.endswith("/"):
        path += "index.html"

    root = os.path.realpath(web_root)
    full = os.path.realpath(os.path.join(root, path.lstrip("/")))
    if full != root and not full.startswith(root + os.sep):
        _http_response(conn, "403 Forbidden", b"forbidden\n", "text/plain")
        return
    if not os.path.isfile(full):
        _http_response(conn, "404 Not Found", b"not found\n", "text/plain")
        return

    try:
        with open(full, "rb") as fp:
            body = fp.read()
    except OSError:
        _http_response(conn, "403 Forbidden", b"forbidden\n", "text/plain")
        return

    ext = os.path.splitext(full)[1].lower()
    _http_response(conn, "200 OK", body, MIME.get(ext, "application/octet-stream"))


def handle_connection(conn, addr, web_root, session, redirect_https=False):
    try:
        request = _read_request(conn)
        if request is None:
            return
        _method, path, headers = request
        route = path.split("?")[0]

        # Web Bluetooth only exists in a secure context. Over plain HTTP
        # navigator.bluetooth is undefined, so the client reports
        # "Bluetooth LE transport is not available" without ever scanning.
        # Redirect plain-HTTP page requests to the HTTPS listener.
        #   - /ws stays on HTTP so existing LAN tooling keeps working.
        #   - HTTPS connections are never redirected (no loop).
        #   - A reverse proxy that already terminated TLS is left alone
        #     (X-Forwarded-Proto: https), so an https://host:8443 entry
        #     proxying to this port is not broken.
        if (redirect_https and route != "/ws" and
                headers.get("x-forwarded-proto", "").lower() != "https"):
            host = headers.get("host", "")
            if host.endswith(":80"):
                host = host[:-3]
            if not host:
                host = addr[0]
            location = "https://%s%s" % (host, path)
            _http_response(conn, "301 Moved Permanently", b"",
                           "text/plain; charset=utf-8",
                           "Location: %s\r\n" % location)
            return

        if route == "/ws" and headers.get("upgrade", "").lower() == "websocket":
            if not session.ws_enabled:
                _http_response(conn, "503 Service Unavailable",
                               b"LAN bridge disabled\n",
                               "text/plain; charset=utf-8")
                return
            key = headers.get("sec-websocket-key", "")
            accept = base64.b64encode(
                hashlib.sha1((key + WS_GUID).encode("ascii")).digest()).decode("ascii")
            conn.sendall(("HTTP/1.1 101 Switching Protocols\r\n"
                          "Upgrade: websocket\r\n"
                          "Connection: Upgrade\r\n"
                          "Sec-WebSocket-Accept: %s\r\n\r\n" % accept).encode("ascii"))
            conn.settimeout(None)
            Client(conn, addr, session).run()
        else:
            serve_file(conn, web_root, path)
    except (ConnectionError, OSError, ValueError) as exc:
        log("http connection %s:%d failed: %s" % (addr[0], addr[1], exc))
    finally:
        try:
            conn.close()
        except OSError:
            pass


def serve_ble_socket(session):
    """Accept connections from /usr/bin/linkr-ble over AF_UNIX."""
    try:
        os.unlink(BLE_SOCK_PATH)
    except FileNotFoundError:
        pass
    except OSError as exc:
        log("cannot remove %s: %s" % (BLE_SOCK_PATH, exc))
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        server.bind(BLE_SOCK_PATH)
    except OSError as exc:
        log("ble socket bind failed: %s" % exc)
        return
    os.chmod(BLE_SOCK_PATH, 0o600)
    server.listen(4)
    log("BLE bridge socket on %s" % BLE_SOCK_PATH)
    while True:
        try:
            conn, _addr = server.accept()
        except OSError as exc:
            log("ble socket accept failed: %s" % exc)
            time.sleep(0.5)
            continue
        threading.Thread(target=BleClient(conn, session).run, daemon=True).start()


def serve_tls(bind, port, web_root, session, cert, key):
    """HTTPS listener. Web Bluetooth needs a secure context, so the same
    page is also served over TLS when a certificate is available."""
    import ssl

    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ctx.load_cert_chain(cert, key)
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind((bind, port))
    server.listen(16)
    log("Linkr Bee HTTPS bridge on %s:%d (cert %s)" % (bind, port, cert))
    while True:
        try:
            conn, addr = server.accept()
        except OSError as exc:
            log("https accept failed: %s" % exc)
            time.sleep(0.5)
            continue
        try:
            conn = ctx.wrap_socket(conn, server_side=True)
        except (ssl.SSLError, OSError) as exc:
            log("https handshake from %s:%d failed: %s" % (addr[0], addr[1], exc))
            try:
                conn.close()
            except OSError:
                pass
            continue
        threading.Thread(target=handle_connection,
                         args=(conn, addr, web_root, session),
                         daemon=True).start()


def main():
    parser = argparse.ArgumentParser(description="Linkr Bee LAN bridge for V851S")
    parser.add_argument("--port", type=int, default=80)
    parser.add_argument("--tls-port", type=int, default=443)
    parser.add_argument("--cert", default="/usr/share/linkr-bee/certs/linkr-bee.crt")
    parser.add_argument("--key", default="/usr/share/linkr-bee/certs/linkr-bee.key")
    parser.add_argument("--bind", default="0.0.0.0")
    parser.add_argument("--web-root", default="/usr/share/linkr-bee/web")
    parser.add_argument("--max-chunk", type=int, default=256,
                        help="max bytes per rpmsg write (MTU-safe)")
    args = parser.parse_args()

    global bridge, serial_writer

    session = Session()
    session.ws_port = args.port
    bridge = RpmsgBridge(session.on_bridge_data, max_chunk=args.max_chunk)
    session.bridge = bridge
    bridge.start()
    session.webdav.start()

    serial_writer = SerialWriter(bridge)
    serial_writer.start()

    threading.Thread(target=serve_ble_socket, args=(session,),
                     name="ble-socket", daemon=True).start()

    tls_enabled = (args.tls_port > 0 and os.path.isfile(args.cert)
                   and os.path.isfile(args.key))
    if tls_enabled:
        threading.Thread(target=serve_tls,
                         args=(args.bind, args.tls_port, args.web_root,
                               session, args.cert, args.key),
                         name="https", daemon=True).start()
    else:
        log("HTTPS disabled (missing %s or %s)" % (args.cert, args.key))

    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind((args.bind, args.port))
    server.listen(16)
    log("Linkr Bee LAN bridge on %s:%d, web root %s" %
        (args.bind, args.port, args.web_root))

    while True:
        conn, addr = server.accept()
        try:
            conn.setsockopt(socket.SOL_SOCKET, socket.SO_SNDTIMEO,
                            struct.pack("ll", 10, 0))
        except OSError:
            pass
        threading.Thread(target=handle_connection,
                         args=(conn, addr, args.web_root, session, tls_enabled),
                         daemon=True).start()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
